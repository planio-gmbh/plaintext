# This is an example configuration file. Copy this file to your application config folder. In a Rails application that
# would be `<Rails.root>/config/plaintext.yml`
#
# Text extraction helper programs.
#
# commands should write the resulting plain text to STDOUT, encoded in UTF-8.
# Use __FILE__ as placeholder for the file path. The values below are the
# defaults.
#
# Byte sequences that are not valid UTF-8 are replaced by a question mark, so
# make sure to pass whatever switch your command needs to produce UTF-8.

# apt-get install poppler-utils
# pdftotext:
#   - /usr/bin/pdftotext
#   - -enc
#   - UTF-8
#   - __FILE__
#   - '-'

# Link URLs are printed next to their link text, e.g. `link text
# [https://example.com/]`, when pdftotext supports -urls (poppler >= 26.09.0).
# Set to false to opt out, or true to force it on.
# pdftotext_urls: false

# apt-get install unrtf
# unrtf has no switch to write UTF-8, its --text output is always Latin-1 and
# is converted by the rtf handler. Replacing it with a command that does write
# UTF-8 will garble accented characters.
# unrtf:
#   - /usr/bin/unrtf
#   - --nopict
#   - --text
#   - __FILE__

# apt-get install catdoc
# catdoc:
#   - /usr/bin/catdoc
#   - -dutf-8
#   - __FILE__
# xls2csv:
#   - /usr/bin/xls2csv
#   - -dutf-8
#   - __FILE__
# catppt:
#   - /usr/bin/catppt
#   - -dutf-8
#   - __FILE__

# apt-get install tesseract-ocr
# tesseract:
#   - /usr/bin/tesseract
#   - __FILE__
#   - stdout
#   - quiet